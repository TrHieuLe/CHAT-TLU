# ==============================================================================
# STUDYBOT TLU - CẤU HÌNH BIẾN MÔI TRƯỜNG
# ==============================================================================

# Khóa API Google Gemini (Bắt buộc một trong hai)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=

# Phiên bản mô hình AI
GEMINI_MODEL=gemini-2.5-flash

# Cơ sở dữ liệu SQLite
DATABASE_URL=sqlite+aiosqlite:///./app.db

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
COLLECTION_NAME=nckh_docs

# Cấu hình Reranking & Retrieval
RERANKER_TYPE=cross_encoder
RERANKER_MODEL=BAAI/bge-reranker-base
CANDIDATES_K=12
RETRIEVAL_TOP_K=4
MIN_RELEVANCE_SCORE=0.15

# Cấu hình CORS (Phân tách bằng dấu phẩy, để trống hoặc * nếu deploy proxy)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend URL (Để trống khi chạy sau Nginx Reverse Proxy để dùng relative path /api)
NEXT_PUBLIC_API_URL=
